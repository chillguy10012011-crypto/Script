local function safeDestroy(obj)
	if obj then pcall(function() obj:Destroy() end) end
end

local function cf(x, y, z, rx, ry, rz)
	return CFrame.new(x, y, z)
		* CFrame.Angles(
			math.rad(rx or 0),
			math.rad(ry or 0),
			math.rad(rz or 0)
		)
end

